{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.k8s-m8s.io/schema/review.schema.json",
  "title": "k8s-m8s automated review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "verdict": {"enum": ["confirmed", "mismatch", "ambiguous"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    }
  }
}
